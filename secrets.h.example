/* ============================================================
   Copy this file to secrets.h and fill in the real values.
   secrets.h is gitignored and must never be committed.

   The sketch compiles without secrets.h — every feature that needs a
   value here is disabled when the value is empty, so the firmware still
   builds and runs on a machine that does not have the file.

   Note the limit of this approach: these end up in the firmware image and
   can be read out with esptool by anyone holding the device. Acceptable
   for the health ping URL and for a write-only ingest token that can be
   rotated in one command — think again before putting anything stronger
   here.
   ============================================================ */

#pragma once

// --- Health ping ------------------------------------------------------
// healthchecks.io ping URL for the dead man's switch. Empty = disabled,
// and the TLS stack is then dropped by the linker (~119 kB of flash).
//
// Recommended settings on their side: period 5 min, grace 15 min, which
// alerts 20 minutes after the last successful ping.
#define HEALTHCHECK_URL "https://hc-ping.com/00000000-0000-0000-0000-000000000000"

// --- Cloud ingest -----------------------------------------------------
// The Worker in cloud/ — see its wrangler.jsonc. The token is a Worker
// secret set with:
//
//   printf '%s' 'THE-TOKEN' | npx wrangler secret put INGEST_TOKEN
//
// (printf, not echo: wrangler does not trim stdin, and a trailing newline
// makes every request fail with 403 while everything looks correct.)
#define INGEST_URL   "https://everflo-ingest.example.workers.dev/ingest"
#define INGEST_TOKEN "replace-me"

// --- Over-the-air update ----------------------------------------------
// Password for flashing over wifi from the Arduino IDE, which then lists
// the unit as a network port (syrgas at 3232). Empty or absent = OTA is
// off, which is the safe default: this port can replace the firmware that
// drives a motor bolted to an oxygen concentrator, and "whoever is on her
// wifi" is not an access policy.
//
// Note the caveat at the top of this file applies here too — the password
// is readable out of the image with esptool. It defends against the
// network, not against someone holding the device.
#define OTA_PASSWORD "replace-me"

// --- Control key -----------------------------------------------------
// With CONTROL_AUTH 1 in the sketch (the default since 1.11.5), everything
// that turns the knob or changes the device — plus/minus, step size, light,
// colour test, restart, firmware check, counter reset — must be signed with
// this key; watching stays open. A build with CONTROL_AUTH 1 and no key here
// does not compile. Make one with:
//
//   node -e 'console.log(require("crypto").randomBytes(20).toString("hex"))'
//
// Her phone gets it once, through the pairing link http://syrgas.local/#k=<key>
// (behind #, so it is never sent over the network), and keeps it. The control
// panel has a key field. Like the other secrets it can be read back out of
// the image with esptool: it defends against the network, not against
// someone holding the device.
// Empty on purpose: a placeholder long enough to compile would be a key that
// is public in this repository. The build refuses until a real one is here.
#define CONTROL_KEY ""
